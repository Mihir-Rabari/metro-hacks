<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket row: severity pill + id/text + sync state -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="12dp" android:paddingBottom="12dp"
    android:paddingLeft="14dp" android:paddingRight="14dp">

    <TextView android:id="@+id/row_pill" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:background="@drawable/pill_s3"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="11sp" android:textStyle="bold"
        android:textColor="#FFE8EDF5"/>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginLeft="10dp" android:layout_marginRight="10dp">
        <TextView android:id="@+id/row_title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#FFE8EDF5"/>
        <TextView android:id="@+id/row_sub" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:maxLines="2" android:ellipsize="end"
            android:textColor="#FF8B96A8" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/row_chip" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:background="@drawable/chip_bg"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textSize="10sp" android:textStyle="bold"
        android:textColor="#FF8B96A8"/>
</LinearLayout>
