<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <!-- hex values inlined: survive even on runner toolchains that
             mis-validate style-item resource references -->
        <item name="android:windowBackground">#FF0B1220</item>
        <item name="android:colorPrimary">#FFF5C518</item>
        <item name="android:colorAccent">#FFF5C518</item>
        <item name="android:statusBarColor">#FF0B1220</item>
        <item name="android:navigationBarColor">#FF0B1220</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Chip">
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="PrimaryButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">#0B1220</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>
</resources>
